Texture2D xe_bilinear_source : register(t0);
SamplerState xe_bilinear_sampler : register(s0);

float4 guest_output_bilinear_ps(float4 position : SV_Position) : SV_Target {
  int2 pixel = (int2)position.xy - xe_bilinear_output_offset;
  float2 uv = (float2(pixel) + 0.5) * xe_bilinear_output_size_inv;
  float3 color = xe_bilinear_source.SampleLevel(xe_bilinear_sampler, uv, 0).xyz;
  return float4(color, 1.0);
}

float4 guest_output_bilinear_dither_ps(float4 position : SV_Position) : SV_Target {
  int2 pixel = (int2)position.xy - xe_bilinear_output_offset;
  float2 uv = (float2(pixel) + 0.5) * xe_bilinear_output_size_inv;
  float3 color = xe_bilinear_source.SampleLevel(xe_bilinear_sampler, uv, 0).xyz;
  uint noise_index = ((pixel.y & 15) << 4) | (pixel.x & 15);
  return float4(saturate(color + kDitherNoise16x16[noise_index]), 1.0);
}


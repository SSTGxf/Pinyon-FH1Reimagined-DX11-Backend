// Single-source UI guest-output shaders for the d3d11 backend (SM 5.0).
// Reconstructed from the fxc disassembly embedded in
// ../bytecode/d3d12_5_1/guest_output_*.h: identical bindings (cbuffer
// push_consts_xe at b0 per stage, xe_*_source at t0, xe_*_sampler at s0),
// identical semantics (normalized-rect stretch with explicit-LOD bilinear
// sampling, 16x16 noise dither added with saturate, alpha 1). The dither
// noise table below is the exact constant table of the original shader.
// Compile with ./compile-ui-d3d11.sh (fxc, *_5_0 profiles):
//   GUEST_OUTPUT_VS=1 vs_5_0 guest_output_triangle_strip_rect_vs
//   (default)        ps_5_0 guest_output_bilinear_ps
//                    ps_5_0 guest_output_bilinear_dither_ps

#if defined(GUEST_OUTPUT_VS)

cbuffer push_consts_xe : register(b0) {
  float2 xe_triangle_strip_rect_offset;
  float2 xe_triangle_strip_rect_size;
};

// Triangle-strip rectangle in clip space (the caller passes the height with
// the sign flipped), generated from SV_VertexID alone.
float4 guest_output_triangle_strip_rect_vs(uint vertex_id : SV_VertexID) : SV_Position {
  float2 corner = float2(vertex_id & 1, vertex_id >> 1);
  return float4(corner * xe_triangle_strip_rect_size + xe_triangle_strip_rect_offset, 0.0, 1.0);
}

